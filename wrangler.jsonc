{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "soma",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "limits": {
    "cpu_ms": 30000
  },
  "vars": {
    "SOMA_CRON_TARGET_URL": "https://soma-neon-phi.vercel.app"
  },
  "triggers": {
    "crons": ["* * * * *"]
  }
}
