# Public application URL used by Vercel and OAuth callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Development-only visual and interaction sandbox. Never enables in production.
SOMA_LOCAL_PREVIEW=false

# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
# Google OAuth is used both for Soma sign-in and the Google Health connection.
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
GOOGLE_HEALTH_WEBHOOK_SECRET=
# Optional. When omitted, Calendar reuses the Google Health OAuth client.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Base64-encoded 32-byte key used to encrypt OAuth tokens before database storage.
TOKEN_ENCRYPTION_KEY=
XAI_API_KEY=
# Assistant conversations use Grok 4.7 through xAI Responses with provider storage disabled.
# Meal analysis is pinned to GPT-6 Luna through OpenAI Responses.
# One bounded provider call runs per durable job attempt. Transient failures are
# retried by the persisted worker, so a page close or server restart cannot lose them.
MEAL_ANALYSIS_PROVIDER_TIMEOUT_MS=52000
# The API key authenticates; it is not the prompt cache key.
OPENAI_MEAL_ANALYSIS_REASONING_EFFORT=low
# Required for GPT-6 Luna meal analysis.
OPENAI_API_KEY=
CRON_SECRET=
# Supabase replaces D1 for the structured Soma data during the migration.
# Keep these server-only: never prefix them with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# R2 access from Vercel uses the S3-compatible API. On Cloudflare, the native
# SOMA_ARCHIVES binding remains the fallback when these variables are absent.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=soma-health-record-archives
# Legacy alias accepted for existing Vercel configurations.
R2_ARCHIVE_BUCKET=
