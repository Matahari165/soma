# Public application URL. Use the final workers.dev or custom-domain URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Development-only visual and interaction sandbox. Never enables in production.
SOMA_LOCAL_PREVIEW=false

# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
# Google OAuth is used both for Soma sign-in and the Google Health connection.
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
GOOGLE_HEALTH_WEBHOOK_SECRET=
# Optional. When omitted, Calendar reuses the Google Health OAuth client.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Base64-encoded 32-byte key used to encrypt OAuth tokens before database storage.
TOKEN_ENCRYPTION_KEY=
XAI_API_KEY=
# Optional. Meal photo analysis defaults to Grok 4.6 through xAI Responses.
XAI_MEAL_VISION_MODEL=grok-4.6
# The primary provider is explicit; xAI remains the default for existing deployments.
MEAL_ANALYSIS_PRIMARY_PROVIDER=xai
MEAL_ANALYSIS_ENABLE_FALLBACK=true
# Per-attempt timeout. Two bounded attempts still stay within the 50s analysis route budget.
MEAL_ANALYSIS_PROVIDER_TIMEOUT_MS=15000
# Optional OpenAI fallback/primary model.
OPENAI_MEAL_ANALYSIS_MODEL=gpt-5.6-sol
OPENAI_MEAL_ANALYSIS_REASONING_EFFORT=low
# Optional xAI validator when OpenAI is not configured.
XAI_MEAL_VALIDATOR_MODEL=
# Optional. GPT-5.6 Sol reviews the primary Grok analysis when configured.
OPENAI_API_KEY=
OPENAI_MEAL_VALIDATOR_MODEL=gpt-5.6-sol
OPENAI_MEAL_VALIDATOR_REASONING_EFFORT=low
CRON_SECRET=
# D1 and R2 are attached as native bindings in wrangler.jsonc; no storage key is needed.
