# Public Supabase project values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
GOOGLE_HEALTH_WEBHOOK_SECRET=
# Base64-encoded 32-byte key used to encrypt OAuth tokens before database storage.
TOKEN_ENCRYPTION_KEY=
OPENAI_API_KEY=
CRON_SECRET=

# Keep demo mode on until authentication and Google Health are configured.
NEXT_PUBLIC_SOMA_DATA_MODE=demo
