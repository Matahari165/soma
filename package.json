{
  "name": "soma",
  "version": "0.1.0",
  "private": true,
  "description": "Personal health intelligence platform & biometric lab correlating wearable physiological data with daily nutrition and habits to reveal the determinants of restorative sleep.",
  "keywords": [
    "health-tech",
    "biometrics",
    "sleep-tracking",
    "nextjs",
    "react19",
    "typescript",
    "supabase",
    "cloudflare-r2",
    "vision-ai"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Matahari165/Soma.git"
  },
  "author": "Soma Contributors",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "preview": "pnpm build && pnpm start",
    "deploy": "echo 'ERREUR: Soma est hébergé sur Vercel. Le déploiement est automatique au merge sur main.' && exit 1",
    "deploy:cloudflare": "echo 'ERREUR: Soma est hébergé sur Vercel, pas Cloudflare. Pour déployer le worker cron: pnpm cron:deploy' && exit 1",
    "cron:deploy": "wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply soma-core --local",
    "db:migrate:remote": "wrangler d1 migrations apply soma-core --remote",
    "db:migrate:supabase": "node scripts/migrate-d1-to-supabase.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@ai-sdk/xai": "^5.0.4",
    "@aws-sdk/client-s3": "3.984.0",
    "@opennextjs/cloudflare": "1.20.2",
    "ai": "^7.0.107",
    "lucide-react": "1.30.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "vitest": "4.1.10",
    "wrangler": "4.125.0"
  },
  "packageManager": "pnpm@11.16.0"
}
